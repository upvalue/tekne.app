---
import "../styles/global.css";
import Intro from '../components/Intro.astro';

interface Props {
  title?: string;
}

const { title = "Tekne" } = Astro.props as Props;
---

<!doctype html>
<html lang="en" class="h-full antialiased dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon/tekne32-sky.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon/tekne180-sky.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <!-- Open Graph meta tags -->
    <meta property="og:title" content="Tekne" />
    <meta property="og:description" content="A freestyle productivity app in the shape of an outline editor" />
    <meta property="og:image" content="/assets/tekne-editor.png" />
    <meta property="og:type" content="website" />

    <slot name="head" />
  </head>
  <body class="min-h-screen bg-page text-text lg:flex lg:h-screen">
    <!-- Left Sidebar -->
    <div class="bg-panel border-b border-white/[0.03] lg:w-128 lg:flex-shrink-0 lg:h-full lg:border-b-0 lg:border-r">
      <div class="flex flex-col gap-y-12 p-6 pt-14 lg:h-full lg:px-18 lg:py-20">
        <div class="text-center lg:text-left">
          <Intro />
        </div>

        <p class="mt-auto flex items-baseline justify-center gap-x-1 text-[0.8125rem]/6 text-muted lg:justify-start">
          a project by
          <a href="https://upvalue.io" class="font-medium text-text-2 transition-colors hover:text-accent">upvalue.io</a>
        </p>
      </div>
    </div>

    <!-- Main Content Area -->
    <div class="flex-1 lg:overflow-y-auto lg:h-full">
      <main class="py-8 lg:py-14">
        <div class="mx-auto max-w-2xl px-8 lg:mx-0 lg:max-w-3xl lg:px-14">
          <slot />
        </div>
      </main>
    </div>
  </body>
</html>
