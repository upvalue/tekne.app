---
import SimpleLayout from '../layouts/SimpleLayout.astro';
import rabbit from '../assets/rabbit.png';
import { Image } from 'astro:assets';
---

<SimpleLayout>
	<div class="flex flex-col items-center justify-center min-h-full gap-y-4">
		<div class="flex flex-row items-center gap-x-4">
			<img src="/assets/rabbit.png" alt="marginalia rabbit" height={96} width={64} />
			<h2 class="text-6xl font-bold text-gray-300 mb-4">tekne</h2>
		</div>
		<div class="text-center">
			<p class="text-xl text-emerald-400 flex flex-row gap-x-4">
				<a href="https://demo.tekne.app">demo</a>
				<a href="https://github.com/upvalue/meditations/tree/tekne">github</a>
			</p>
		</div>
		<p class="prose prose-invert">Tekne is a freestyle productivity app in the shape of an outline editor.</p>
		<p class="prose prose-invert">Under heavy construction.</p>
	</div>
</SimpleLayout>
