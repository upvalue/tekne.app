---
import CommitLayout from '../layouts/CommitLayout.astro';
---

<CommitLayout>
	<article class="prose prose-invert max-w-none">
		<h2 class="text-2xl font-bold mb-6">
			Tekne
		</h2>
		
		<p>
			Tekne is an freestyle productivity app in the shape of an outline editor.
		</p>
		
		<h3 class="text-xl font-semibold text-white mb-4">Freeform data over time</h3>
		<p>
			Tekne's core feature is that it allows you to track freeform data over time.
		</p>

		<p>
			Use this.
		</p>

		<a href="https://demo.tekne.app" class="flex items-center text-sky-400 gap-x-2 no-underline">
			Check out the demo
				<div class="w-6 h-6">	
					<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" strokeWidth={1.5} stroke="currentColor" className="size-6">
						<path strokeLinecap="round" strokeLinejoin="round" d="M17.25 8.25 21 12m0 0-3.75 3.75M21 12H3" />
					</svg>
				</div>
		</a>
	</article>
</CommitLayout>
